<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Restage</AssemblyName>
    <RootNamespace>Restage</RootNamespace>
    <ApplicationIcon>Assets\Restage.ico</ApplicationIcon>
    <Version>1.0.0-beta.2</Version>
    <Product>Restage</Product>
    <Company>Restage</Company>
    <Copyright>© 2026 Anurag Patil</Copyright>
    <AssemblyTitle>Restage — workspace snapshot and restore</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Restage.ico" />
    <Resource Include="Assets\Restage-256.png" />
    <!-- Inter (SIL OFL 1.1, license alongside). Static weights, not the
         variable TTF: WPF renders only a variable font's default instance,
         so Medium and SemiBold would silently come out Regular. -->
    <Resource Include="Assets\Fonts\Inter-Regular.ttf" />
    <Resource Include="Assets\Fonts\Inter-Medium.ttf" />
    <Resource Include="Assets\Fonts\Inter-SemiBold.ttf" />
  </ItemGroup>

</Project>
