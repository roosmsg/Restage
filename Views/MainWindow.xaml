<Window x:Class="Rewake.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rewake" Height="740" Width="1160"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource BgBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- One row of the restore overlay's checklist -->
        <DataTemplate x:Key="RestoreRowTemplate">
            <Border x:Name="RowBd" Background="Transparent" CornerRadius="2"
                    Padding="8,5" Margin="0,1">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="20" Height="20"
                          Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="20" Height="20"/>
                        <Border Background="{DynamicResource SelectedBrush}" CornerRadius="2"
                                Visibility="{Binding FallbackVisibility, Mode=OneWay}">
                            <TextBlock Text="{Binding Initial, Mode=OneWay}" FontSize="10"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,2,0">
                        <Path x:Name="RowSpinner" Style="{StaticResource SpinnerPath}"
                              Stroke="{DynamicResource TextBrush}" Visibility="Collapsed"
                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="RowCheck" Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="Collapsed"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="RowStatus" Text="{Binding StatusText, Mode=OneWay}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12.5"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Sub, Mode=OneWay}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter TargetName="RowBd" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Launching">
                    <Setter TargetName="RowBd" Property="Background"
                            Value="{DynamicResource CardHoverBrush}"/>
                    <Setter TargetName="RowSpinner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="RowStatus" Property="Foreground"
                            Value="{DynamicResource TextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Opened">
                    <Setter TargetName="RowCheck" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="RowStatus" Property="Foreground"
                            Value="{DynamicResource AccentBrush}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowCheck"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.3" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RowCheck"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.3" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="RowStatus" Property="Foreground"
                            Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- Sidebar width and bottom-panel height are restored from settings on
             load; the mins keep either pane from being dragged out of existence. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="240"/>
            <RowDefinition x:Name="BottomRow" Height="181" MinHeight="128"/>
        </Grid.RowDefinitions>

        <!-- ============ Content: sidebar + main ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="272" MinWidth="208" MaxWidth="520"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: capture history -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,16,16,8">
                        <TextBlock Text="CAPTURE HISTORY" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding HistoryCount}" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,12">
                        <TextBlock Text="{Binding CaptureStats}" FontSize="11.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,9"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                Command="{Binding OpenDataFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Open Data Folder"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Snapshots}"
                             SelectedItem="{Binding SelectedSnapshot}"
                             Background="Transparent" BorderThickness="0" Margin="8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SnapItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayLabel, Mode=OneWay}" FontWeight="SemiBold"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsLastSession, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="BEFORE SHUTDOWN" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SubLine, Mode=OneWay}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main: selected capture contents (+ restore overlay on top) -->
            <Grid Grid.Column="1">
            <DockPanel Margin="26,18,26,10">

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Header}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SubHeader}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButton}" Content="{Binding ThemeGlyph}"
                                ToolTip="{Binding ThemeTooltip}" Command="{Binding ToggleThemeCommand}"
                                Margin="0,0,10,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                ToolTip="Delete Capture" AutomationProperties.Name="Delete Capture"
                                Command="{Binding DeleteCaptureCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource BusyAccentButton}" Width="34" Height="34" Padding="0"
                                ToolTip="Capture Now" AutomationProperties.Name="Capture Now"
                                Command="{Binding CaptureNowCommand}" Margin="0,0,10,0">
                            <Grid>
                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Path Style="{StaticResource SpinnerPath}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource BusyAccentButton}" Padding="18,8"
                                Command="{Binding RestoreCommand}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,9,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Restore Workspace"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVis}}">
                                    <Path Style="{StaticResource SpinnerPath}" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Restoring…" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <Grid Margin="2,0,2,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="APPLICATIONS" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding AppCount}" FontSize="11" Margin="7,0,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right" IsThreeState="False"
                                      IsChecked="{Binding AllSelected}" FontSize="12"
                                      Foreground="{DynamicResource MutedBrush}" Content="Select all"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                          IsThreeState="False"
                                                          IsChecked="{Binding GroupSelected, Mode=TwoWay}"/>
                                                <Grid DockPanel.Dock="Left" Width="24" Height="24" Margin="12,0,12,0">
                                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                                           VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="3"
                                                            Visibility="{Binding FallbackVisibility, Mode=OneWay}">
                                                        <TextBlock Text="{Binding Initial, Mode=OneWay}" FontWeight="Bold"
                                                                   FontSize="11" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ExpandToggle}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              Visibility="{Binding BadgeVisibility, Mode=OneWay}"
                                                              VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                                                        <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrush2}"
                                                                BorderThickness="1" CornerRadius="2" Padding="6,1"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding BadgeVisibility, Mode=OneWay}">
                                                            <TextBlock Text="{Binding CountLabel, Mode=OneWay}" FontSize="10"
                                                                       Foreground="{DynamicResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subtitle, Mode=OneWay}" FontSize="11" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Instances}" Margin="50,8,0,2"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3">
                                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="12"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="2,14,2,8">
                            <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding FolderCount}" FontSize="11" Margin="7,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="22" Height="22"
                                                   Margin="12,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Parent, Mode=OneWay}" FontSize="11" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Restore overlay: dims the capture list while a restore runs,
                 lingers a few seconds with the summary, then fades away -->
            <Border Background="{DynamicResource OverlayDimBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRestorePanel}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.35"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"
                                                                           BeginTime="0:0:0.35" Duration="0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="4" Width="460" MaxHeight="440"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="22,18,22,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Style="{StaticResource SpinnerPath}"
                                          Stroke="{DynamicResource TextBrush}"
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Restoring workspace" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Restore finished" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding RestoreCounter, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="Apps open one at a time so your PC stays fast"
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,3,0,10"/>
                        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource ThinProgress}"
                                     Maximum="1" Value="{Binding RestoreFraction, Mode=OneWay}"
                                     Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RestoreProgress}"
                                          ItemTemplate="{StaticResource RestoreRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>
            </Grid>

            <!-- Seam between history and contents. Sits over the sidebar's own
                 1px border, so the layout looks exactly as it did before. -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="7" Margin="-4,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" Focusable="False"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                          DragCompleted="SidebarSplitter_DragCompleted"
                          ToolTip="Drag to resize the capture history"/>
        </Grid>

        <!-- ============ Full-width bottom panel ============ -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                Padding="26,12,26,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,0,10">
                    <CheckBox IsChecked="{Binding AutoCapture}" Margin="0,0,22,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Auto capture" FontSize="12.5"/>
                            <TextBlock Text="every 2 min" FontSize="11" Margin="7,1,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Content="Run at startup" FontSize="12.5"
                              IsChecked="{Binding StartWithWindows}" Margin="0,0,22,0"/>
                    <CheckBox Content="Force relaunch" FontSize="12.5"
                              IsChecked="{Binding ForceLaunch}"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="2,0,0,6">
                    <TextBlock Text="ACTIVITY LOG" Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center"/>
                    <ToggleButton x:Name="LogToggle" Style="{StaticResource ExpandToggle}"
                                  HorizontalAlignment="Right" Margin="0,-6,0,-6"
                                  Checked="LogToggle_Toggled" Unchecked="LogToggle_Toggled"
                                  ToolTip="Show or hide the activity log"/>
                </Grid>

                <!-- Undocked, so it fills whatever height the splitter leaves. -->
                <Border x:Name="LogArea" Background="{DynamicResource LogBgBrush}"
                        CornerRadius="3" Padding="8,4">
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Seam above the bottom panel; overlays its 1px top border. -->
        <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="7" Margin="0,-4,0,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      Background="Transparent" Cursor="SizeNS" Focusable="False"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent"
                      DragCompleted="LogSplitter_DragCompleted"
                      ToolTip="Drag to resize the activity log"/>
    </Grid>
</Window>
