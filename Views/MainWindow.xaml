<Window x:Class="Restage.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restage" Height="740" Width="1160"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing">
    <!-- No native title bar: the app bar below is the title bar. CaptionHeight
         matches its 42px + 1px border, so that strip drags, double-clicks to
         maximize, and right-clicks to the system menu the way a caption should.
         Anything clickable inside it needs IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="43" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- IconButton that swaps its camera for a spinner mid-capture. Lives
             here rather than App.xaml because the trigger reads IsCapturing off
             this window's view model. -->
        <Style x:Key="CaptureIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Grid>
                                <Viewbox x:Name="IconBox" Width="{TemplateBinding FontSize}"
                                         Height="{TemplateBinding FontSize}">
                                    <Path x:Name="Glyph" Width="24" Height="24"
                                          Data="{StaticResource IconCamera}"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Viewbox>
                                <Path x:Name="Spin" Style="{StaticResource SpinnerPath}"
                                      Stroke="{DynamicResource TextBrush}" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDisabledBrush}"/>
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                <Setter TargetName="IconBox" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="Spin" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Favourite star for the selected capture. The template takes its
             outline from Foreground and its fill from Tag, so one DataTrigger on
             the button turns a grey outline into a solid green star: a
             ControlTemplate trigger can't see the view model, and a Style trigger
             can't reach a part inside the template. -->
        <Style x:Key="FavoriteIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Viewbox Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}">
                                <Path x:Name="Glyph" Width="24" Height="24"
                                      Data="{StaticResource IconStar}"
                                      Fill="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2.25"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDisabledBrush}"/>
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIsFavorite}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Tag" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One row of the restore overlay's checklist -->
        <DataTemplate x:Key="RestoreRowTemplate">
            <Border x:Name="RowBd" Background="Transparent" CornerRadius="0"
                    Padding="8,5" Margin="0,1">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="20" Height="20"
                          Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="20" Height="20"/>
                        <Border Background="{DynamicResource SelectedBrush}" CornerRadius="0"
                                Visibility="{Binding FallbackVisibility, Mode=OneWay}">
                            <TextBlock Text="{Binding Initial, Mode=OneWay}" FontSize="10"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,2,0">
                        <Path x:Name="RowSpinner" Style="{StaticResource SpinnerPath}"
                              Stroke="{DynamicResource TextBrush}" Visibility="Collapsed"
                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <Viewbox x:Name="RowCheck" Width="13" Height="13"
                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                 Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Viewbox.RenderTransform>
                            <Path Width="24" Height="24" Data="{StaticResource IconCheck}"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Viewbox>
                        <TextBlock x:Name="RowStatus" Text="{Binding StatusText, Mode=OneWay}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12.5"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Sub, Mode=OneWay}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter TargetName="RowBd" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Launching">
                    <Setter TargetName="RowBd" Property="Background"
                            Value="{DynamicResource CardHoverBrush}"/>
                    <Setter TargetName="RowSpinner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="RowStatus" Property="Foreground"
                            Value="{DynamicResource TextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Opened">
                    <Setter TargetName="RowCheck" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="RowStatus" Property="Foreground"
                            Value="{DynamicResource AccentBrush}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowCheck"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.3" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RowCheck"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.3" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="RowStatus" Property="Foreground"
                            Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- Sidebar width and bottom-panel height are restored from settings on
             load; the mins keep either pane from being dragged out of existence. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Height="42">
                <!-- Centred on the window rather than on either pane, so the name
                     holds still while the sidebar is resized or hidden. -->
                <TextBlock Text="Restage" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="6,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton x:Name="SidebarToggle" Style="{StaticResource IconToggle}"
                                  Tag="{StaticResource IconPanelLeft}"
                                  Checked="SidebarToggle_Toggled" Unchecked="SidebarToggle_Toggled"
                                  AutomationProperties.Name="Toggle Sidebar"
                                  ToolTip="Toggle Sidebar"/>
                </StackPanel>

                <!-- Settings sits with the window buttons, separated by a gap
                     rather than a rule: a 34px centred button against 46px
                     full-height ones already reads as two groups. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                        <ToggleButton x:Name="SettingsToggle" Style="{StaticResource IconToggle}"
                                      Tag="{StaticResource IconSettings}"
                                      AutomationProperties.Name="Settings" ToolTip="Settings"/>
                        <!-- Stay Awake runs with the window closed, so its only
                             always-visible tell is this dot on the gear. -->
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,5,5,0" IsHitTestVisible="False"
                                 Visibility="{Binding IsStayAwakeActive, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMinus}"
                            Click="Minimize_Click" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize"/>
                    <Button Click="MaxRestore_Click" AutomationProperties.Name="Maximize">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                <Setter Property="Tag" Value="{StaticResource IconSquare}"/>
                                <Setter Property="ToolTip" Value="Maximize"/>
                                <Style.Triggers>
                                    <DataTrigger Value="Maximized"
                                                 Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Setter Property="Tag" Value="{StaticResource IconRestoreWindow}"/>
                                        <Setter Property="ToolTip" Value="Restore"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Tag="{StaticResource IconClose}"
                            Click="CloseWindow_Click" ToolTip="Close"
                            AutomationProperties.Name="Close"/>
                </StackPanel>

                <!-- Anchored to the gear; IsOpen rides the toggle both ways. The
                     gear sits near the right edge, so the panel hangs to the left
                     of it: Popup offsets from the target's left edge, so
                     right-aligning the two means shifting by the width
                     difference — 34 (gear) - 238 (222 border + 8 shadow margin
                     each side) = -204. Change the border width, change this. -->
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsToggle}"
                       Placement="Bottom" HorizontalOffset="-204" VerticalOffset="2"
                       StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                       Opened="SettingsPopup_Opened" Closed="SettingsPopup_Closed">
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            CornerRadius="0" Margin="8" Padding="8" Width="222">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="SETTINGS" Style="{StaticResource SectionLabel}"
                                       Margin="7,4,7,10"/>
                            <CheckBox IsChecked="{Binding AutoCapture}" Margin="7,0,7,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Auto capture" FontSize="12.5"/>
                                    <TextBlock Text="every 2 min" FontSize="11" Margin="7,1,0,0"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Content="Run at startup" FontSize="12.5"
                                      IsChecked="{Binding StartWithWindows}" Margin="7,0,7,12"/>
                            <CheckBox Content="Force relaunch" FontSize="12.5"
                                      IsChecked="{Binding ForceLaunch}" Margin="7,0,7,4"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}"
                                    Margin="0,6"/>

                            <!-- Dark shows the sun (what the click gets you), light
                                 shows the moon; the label is the same promise. -->
                            <Button Command="{Binding ToggleThemeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
                                        <Setter Property="Tag" Value="{StaticResource IconSun}"/>
                                        <Setter Property="Content" Value="{Binding ThemeTooltip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                                <Setter Property="Tag" Value="{StaticResource IconMoon}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}"
                                    Tag="{StaticResource IconFolderOpen}"
                                    Content="Open data folder"
                                    Command="{Binding OpenDataFolderCommand}"/>
                            <!-- Opens the Stay Awake dialog; the dot mirrors the
                                 gear's so the row itself says whether it runs. -->
                            <Grid>
                                <Button Style="{StaticResource MenuRowButton}"
                                        Tag="{StaticResource IconBell}"
                                        Content="Stay awake…"
                                        Command="{Binding OpenStayAwakeCommand}"
                                        Click="StayAwakeRow_Click"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Margin="0,0,8,0" IsHitTestVisible="False"
                                         Visibility="{Binding IsStayAwakeActive, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ============ Content: sidebar + main ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="272" MinWidth="208" MaxWidth="520"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: capture history -->
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,12,10,8">
                        <TextBlock Text="CAPTURE HISTORY" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding HistoryCount}" Style="{StaticResource NumericText}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <Button Style="{StaticResource SubtleIconButton}" Tag="{StaticResource IconEraser}"
                                    Command="{Binding ClearHistoryCommand}"
                                    AutomationProperties.Name="Clear History"
                                    ToolTip="Clear capture history"/>
                        </StackPanel>
                    </Grid>

                    <!-- Open Data Folder used to live here; it moved to the app bar,
                         where it stays reachable with the sidebar hidden. -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CaptureStats}"
                               Style="{StaticResource NumericText}" FontSize="11.5"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="14,10,14,14"/>

                    <ListBox ItemsSource="{Binding Snapshots}"
                             SelectedItem="{Binding SelectedSnapshot}"
                             Background="Transparent" BorderThickness="0" Margin="8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="Scrollable_PreviewMouseWheel">
                        <ListBox.ItemContainerStyle>
                            <!-- The padding moves into the row itself, so the
                                 context menu covers the row edge to edge. -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SnapItemStyle}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Background, not just padding: a transparent
                                     brush is still hit-testable, so right-click
                                     works anywhere on the row. The menu lives
                                     here rather than on the container style
                                     because a DataTemplate is instantiated per
                                     row — one shared menu in a Setter would show
                                     the first row's data for every row. -->
                                <Border Background="Transparent" Padding="11,9">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding FavoriteLabel}"
                                                      Tag="{StaticResource IconStar}"
                                                      Command="{Binding ToggleFavoriteCommand}"/>
                                            <MenuItem Header="Rename…"
                                                      Tag="{StaticResource IconPencil}"
                                                      Command="{Binding RenameCommand}"/>
                                            <MenuItem Header="Delete capture"
                                                      Tag="{StaticResource IconTrash}"
                                                      Command="{Binding DeleteCommand}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- A star gutter every row pays for,
                                                 so the labels keep one left edge. -->
                                            <ColumnDefinition Width="19"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="12" Height="12" Margin="0,1,0,0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                            <Path Width="24" Height="24" Data="{StaticResource IconStar}"
                                                  Fill="{DynamicResource AccentBrush}"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.25"
                                                  StrokeLineJoin="Round"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayLabel, Mode=OneWay}" FontWeight="SemiBold"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="0"
                                                        Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsLastSession, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="BEFORE SHUTDOWN" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SubLine, Mode=OneWay}" Style="{StaticResource NumericText}"
                                                       FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main: selected capture contents (+ restore overlay on top),
                 with the activity log beneath it. The log lives in this column
                 rather than across the window so the history runs the full
                 height and the log starts at the seam. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="240"/>
                    <RowDefinition x:Name="BottomRow" Height="181" MinHeight="96"/>
                </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="26,18,26,10">

                <!-- Capture and delete are ghost icons; Restore is the only
                     accent fill on screen. Two filled green buttons side by side
                     told you nothing about which one you came here to press. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Header}" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="{Binding SubHeader}" Style="{StaticResource SubtleText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Outlined now, so they need room to read as two boxes
                             rather than one segmented control. -->
                        <Button Style="{StaticResource CaptureIconButton}"
                                ToolTip="Capture now" AutomationProperties.Name="Capture Now"
                                Command="{Binding CaptureNowCommand}" Margin="0,0,16,0"/>
                        <Button Style="{StaticResource BusyAccentButton}" Padding="16,9"
                                Command="{Binding RestoreCommand}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0">
                                        <Path Width="24" Height="24" Data="{StaticResource IconRotateCcw}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2.25" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Restore Workspace" FontSize="12.5"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVis}}">
                                    <Path Style="{StaticResource SpinnerPath}" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Restoring…" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="Scrollable_PreviewMouseWheel">
                    <StackPanel Margin="0,0,8,0">
                        <Grid Margin="2,0,2,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="APPLICATIONS" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding AppCount}" Style="{StaticResource NumericText}"
                                           FontSize="11" Margin="7,0,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right" IsThreeState="False"
                                      IsChecked="{Binding AllSelected}" FontSize="12"
                                      Foreground="{DynamicResource MutedBrush}" Content="Select all"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                          IsThreeState="False"
                                                          IsChecked="{Binding GroupSelected, Mode=TwoWay}"/>
                                                <Grid DockPanel.Dock="Left" Width="24" Height="24" Margin="12,0,12,0">
                                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                                           VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="0"
                                                            Visibility="{Binding FallbackVisibility, Mode=OneWay}">
                                                        <TextBlock Text="{Binding Initial, Mode=OneWay}" FontWeight="Bold"
                                                                   FontSize="11" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ExpandToggle}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              Visibility="{Binding BadgeVisibility, Mode=OneWay}"
                                                              VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                                                        <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrush2}"
                                                                BorderThickness="1" CornerRadius="0" Padding="6,1.5"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding BadgeVisibility, Mode=OneWay}">
                                                            <TextBlock Text="{Binding CountLabel, Mode=OneWay}" FontSize="10"
                                                                       Foreground="{DynamicResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subtitle, Mode=OneWay}" FontSize="11" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Instances}" Margin="50,8,0,2"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3">
                                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="12"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="2,14,2,8">
                            <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding FolderCount}" Style="{StaticResource NumericText}"
                                       FontSize="11" Margin="7,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="22" Height="22"
                                                   Margin="12,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Parent, Mode=OneWay}" FontSize="11" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Restore overlay: dims the capture list while a restore runs,
                 lingers a few seconds with the summary, then fades away -->
            <Border Grid.Row="0" Background="{DynamicResource OverlayDimBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRestorePanel}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.35"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"
                                                                           BeginTime="0:0:0.35" Duration="0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="0" Width="460" MaxHeight="440"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="22,18,22,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Style="{StaticResource SpinnerPath}"
                                          Stroke="{DynamicResource TextBrush}"
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Restoring workspace" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Path Width="24" Height="24" Data="{StaticResource IconCheck}"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Restore finished" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding RestoreCounter, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="Apps open one at a time so your PC stays fast"
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,3,0,10"/>
                        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource ThinProgress}"
                                     Maximum="1" Value="{Binding RestoreFraction, Mode=OneWay}"
                                     Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RestoreProgress}"
                                          ItemTemplate="{StaticResource RestoreRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>
            <!-- ============ Activity log ============ -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                    Padding="26,12,26,14">
                <DockPanel>
                    <!-- The three preference checkboxes moved into the app bar's gear. -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,6">
                        <TextBlock Text="ACTIVITY LOG" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,-6,0,-6">
                            <Button Style="{StaticResource SubtleIconButton}" Tag="{StaticResource IconEraser}"
                                    Command="{Binding ClearLogCommand}"
                                    AutomationProperties.Name="Clear Log"
                                    ToolTip="Clear activity log"/>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource ExpandToggle}"
                                          Checked="LogToggle_Toggled" Unchecked="LogToggle_Toggled"
                                          ToolTip="Show or hide the activity log"/>
                        </StackPanel>
                    </Grid>

                    <!-- Undocked, so it fills whatever height the splitter leaves. -->
                    <Border x:Name="LogArea" Background="{DynamicResource LogBgBrush}"
                            CornerRadius="0" Padding="8,4">
                        <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                 ItemContainerStyle="{StaticResource PlainListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False"
                                 PreviewMouseWheel="Scrollable_PreviewMouseWheel"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Seam above the bottom panel; overlays its 1px top border. -->
            <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="7" Margin="0,-4,0,0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top"
                          Background="Transparent" Cursor="SizeNS" Focusable="False"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent"
                          DragCompleted="LogSplitter_DragCompleted"
                          ToolTip="Drag to resize the activity log"/>
            </Grid>

            <!-- Confirmation prompt. Spans both columns but not the title bar,
                 so the window stays movable and closable while it is up. -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource OverlayDimBrush}"
                    Panel.ZIndex="10"
                    Visibility="{Binding ShowConfirm, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                        Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="24,20,24,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConfirmMessage}" Style="{StaticResource SubtleText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <!-- Collapsed for a plain confirmation, so the spacing
                             below the message comes from whichever element is
                             actually there. MaxLength keeps a name inside the
                             sidebar it has to fit in. -->
                        <TextBox x:Name="ConfirmInputBox" Margin="0,14,0,0" MaxLength="48"
                                 Text="{Binding ConfirmInput, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ConfirmIsInput, Converter={StaticResource BoolToVis}}"
                                 IsVisibleChanged="ConfirmInput_IsVisibleChanged"
                                 KeyDown="ConfirmInput_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource QuietButton}" Content="Cancel"
                                    Command="{Binding ConfirmCancelCommand}" Margin="0,0,8,0"
                                    IsCancel="True"/>
                            <Button Style="{StaticResource AccentButton}" Padding="16,9" FontSize="12.5"
                                    Content="{Binding ConfirmAcceptLabel}"
                                    Command="{Binding ConfirmAcceptCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Stay Awake: configure-and-start dialog. Same overlay treatment
                 as the confirmation prompt; the service it fronts lives in the
                 tray process, so closing this dialog (or the window) does not
                 stop a running keeper — only Stop does. -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource OverlayDimBrush}"
                    Panel.ZIndex="11"
                    Visibility="{Binding ShowStayAwake, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                        Width="392" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="20,14,10,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Path Width="24" Height="24" Data="{StaticResource IconBell}"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="STAY AWAKE" Style="{StaticResource SectionLabel}"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource SubtleIconButton}" Tag="{StaticResource IconClose}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding CloseStayAwakeCommand}"
                                    ToolTip="Close" AutomationProperties.Name="Close Stay Awake"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush2}"/>

                        <!-- Config: read-only while running, so what the status
                             line reports is always what was started. -->
                        <StackPanel Margin="20,14,20,4">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStayAwakeActive}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="NUDGE EVERY" Style="{StaticResource SectionLabel}"
                                       FontSize="10.5" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="SaInterval"
                                             Content="30 s" Margin="0,0,6,0"
                                             IsChecked="{Binding StayAwakeIntervalSeconds, Converter={StaticResource EqualsParam}, ConverterParameter=30}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="SaInterval"
                                             Content="1 min" Margin="0,0,6,0"
                                             IsChecked="{Binding StayAwakeIntervalSeconds, Converter={StaticResource EqualsParam}, ConverterParameter=60}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="SaInterval"
                                             Content="2 min" Margin="0,0,6,0"
                                             IsChecked="{Binding StayAwakeIntervalSeconds, Converter={StaticResource EqualsParam}, ConverterParameter=120}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="SaInterval"
                                             Content="5 min" Margin="0,0,10,0"
                                             IsChecked="{Binding StayAwakeIntervalSeconds, Converter={StaticResource EqualsParam}, ConverterParameter=300}"/>
                                <TextBlock Text="custom" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
                                <TextBox Width="42" FontSize="12" Padding="4,3"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding StayAwakeIntervalSeconds, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Seconds between nudges (10–3600)"/>
                                <TextBlock Text="s" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="METHOD" Style="{StaticResource SectionLabel}"
                                       FontSize="10.5" Margin="0,0,0,8"/>
                            <RadioButton Style="{StaticResource DotRadio}" GroupName="SaMethod" Margin="0,0,0,8"
                                         IsChecked="{Binding StayAwakeMethod, Converter={StaticResource EqualsParam}, ConverterParameter=Invisible}">
                                <StackPanel>
                                    <TextBlock Text="Invisible nudge" FontSize="12.5"/>
                                    <TextBlock Text="1 px move &amp; return — the cursor never visibly moves"
                                               FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource DotRadio}" GroupName="SaMethod" Margin="0,0,0,8"
                                         IsChecked="{Binding StayAwakeMethod, Converter={StaticResource EqualsParam}, ConverterParameter=Visible}">
                                <StackPanel>
                                    <TextBlock Text="Visible nudge" FontSize="12.5"/>
                                    <TextBlock Text="drifts the cursor a few pixels and back"
                                               FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource DotRadio}" GroupName="SaMethod" Margin="0,0,0,14"
                                         IsChecked="{Binding StayAwakeMethod, Converter={StaticResource EqualsParam}, ConverterParameter=Key}">
                                <StackPanel>
                                    <TextBlock Text="Key press (F15)" FontSize="12.5"/>
                                    <TextBlock Text="for apps that watch the keyboard instead"
                                               FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabel}"
                                       FontSize="10.5" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding StayAwakeOnlyWhenIdle}" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Only when I'm idle" FontSize="12.5"/>
                                    <TextBlock Text="never fights real input" FontSize="11" Margin="7,1,0,0"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding StayAwakeAutoStop}" VerticalAlignment="Center"
                                          Content="Stop automatically after" FontSize="12.5"/>
                                <TextBox Width="34" FontSize="12" Padding="4,3" Margin="8,0,0,0"
                                         HorizontalContentAlignment="Center"
                                         IsEnabled="{Binding StayAwakeAutoStop}"
                                         Text="{Binding StayAwakeAutoStopHours, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Hours before it stops on its own (1–24)"/>
                                <TextBlock Text="hours" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush2}"/>
                        <Grid Margin="20,12,20,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                         Margin="0,0,7,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsStayAwakeActive, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding StayAwakeStatus}" FontSize="11.5"
                                           Style="{StaticResource NumericText}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="Start" Padding="16,9" FontSize="12.5"
                                    HorizontalAlignment="Right"
                                    Command="{Binding StayAwakeToggleCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStayAwakeActive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Stop" Style="{StaticResource DangerOutlineButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding StayAwakeToggleCommand}"
                                    Visibility="{Binding IsStayAwakeActive, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Seam between history and contents. Sits over the sidebar's own
                 1px border, so the layout looks exactly as it did before. -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="7" Margin="-4,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" Focusable="False"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                          DragCompleted="SidebarSplitter_DragCompleted"
                          ToolTip="Drag to resize the capture history"/>
        </Grid>

    </Grid>
</Window>
