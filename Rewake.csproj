<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Rewake</AssemblyName>
    <RootNamespace>Rewake</RootNamespace>
    <ApplicationIcon>Assets\Rewake.ico</ApplicationIcon>
    <Version>1.0.0-beta.1</Version>
    <Product>Rewake</Product>
    <Company>Rewake</Company>
    <Copyright>© 2026 Anurag Patil</Copyright>
    <AssemblyTitle>Rewake — workspace snapshot and restore</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Rewake.ico" />
    <Resource Include="Assets\Rewake-256.png" />
  </ItemGroup>

</Project>
