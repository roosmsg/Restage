<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local feed list, so a build never depends on what the machine's
     user-level NuGet.Config happens to contain. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
