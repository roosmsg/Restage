<Window x:Class="Restage.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Restage.Views"
        Title="Restage" Height="780" Width="1240"
        MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing">
    <!-- No native title bar: the app bar below is the title bar. CaptionHeight
         matches its 42px + 1px border, so that strip drags, double-clicks to
         maximize, and right-clicks to the system menu the way a caption should.
         Anything clickable inside it needs IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="43" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A 20px icon with a lettered fallback, shared by every list row. -->
        <DataTemplate x:Key="RowIcon">
            <Grid Width="20" Height="20">
                <Image Source="{Binding Icon}" Width="20" Height="20"/>
                <Border Background="{DynamicResource SelectedBrush}"
                        Visibility="{Binding FallbackVisibility, Mode=OneWay}">
                    <TextBlock Text="{Binding Initial, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- One workspace in the gallery. -->
        <DataTemplate x:Key="CardTemplate">
            <Border Width="280" Margin="0,0,16,16" BorderThickness="1" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel>
                    <Grid Height="124" Background="{DynamicResource LogBgBrush}" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        <TextBlock Text="No preview" Style="{StaticResource SubtleText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding NoThumbnail, Converter={StaticResource BoolToVis}}"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                Background="#B3000000" Padding="7,3"
                                Visibility="{Binding HasDesktop, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                    <Path Width="24" Height="24" Data="{StaticResource IconMonitor}"
                                          Stroke="White" StrokeThickness="2.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="{Binding DesktopName}" FontSize="10.5" Foreground="White"
                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="12,10,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource SubtleText}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="2" Text="{Binding TimesText}" Style="{StaticResource SubtleText}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Button Style="{StaticResource SmallAccentButton}" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="Start this workspace">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Path Width="24" Height="24" Data="{StaticResource IconPlay}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2.25" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Start" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SubtleIconButton}" Tag="{StaticResource IconRefreshCw}"
                                        ToolTip="Update from the current desktop"
                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One item of the selected workspace, in the details pane. -->
        <DataTemplate x:Key="ItemRowTemplate">
            <Border Style="{StaticResource CardStyle}" Padding="10,8">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                              IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip="Include when restoring"/>
                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource RowIcon}"
                                      Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="8,3" FontSize="10.5"
                            Content="{Binding PolicyLabel}" VerticalAlignment="Center"
                            ToolTip="How to bring it back; click to change"
                            Command="{Binding DataContext.NextPolicyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <!-- Open the saved note/folder/file, or just start the app. -->
                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="10.5"
                              IsChecked="{Binding OpenContent, Mode=TwoWay}" Content="{Binding ContentLabel}"
                              Foreground="{DynamicResource MutedBrush}"
                              Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"
                              ToolTip="Ticked: open the saved note, folder or file. Unticked: just start the app."/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding PlacementText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding KindLabel}" FontSize="10" Margin="7,2,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- One window found by a capture. -->
        <DataTemplate x:Key="CaptureRowTemplate">
            <Border Style="{StaticResource CardStyle}" Padding="10,7">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource RowIcon}"
                                      Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- One row of the restore overlay. -->
        <DataTemplate x:Key="RestoreRowTemplate">
            <Border x:Name="RowBd" Background="Transparent" Padding="8,5" Margin="0,1">
                <DockPanel>
                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource RowIcon}"
                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,2,0">
                        <Path x:Name="RowSpinner" Style="{StaticResource SpinnerPath}"
                              Stroke="{DynamicResource TextBrush}" Visibility="Collapsed"
                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <Viewbox x:Name="RowCheck" Width="13" Height="13" VerticalAlignment="Center"
                                 Margin="0,0,6,0" Visibility="Collapsed">
                            <Path Width="24" Height="24" Data="{StaticResource IconCheck}"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <TextBlock x:Name="RowStatus" Text="{Binding StatusText, Mode=OneWay}" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Sub, Mode=OneWay}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter TargetName="RowBd" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Launching">
                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter TargetName="RowSpinner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="RowStatus" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Opened">
                    <Setter TargetName="RowCheck" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="RowStatus" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="RowStatus" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Overlay panel chrome shared by every dialog-like overlay. The shadow is
             an empty layer behind the panel, not an Effect on it: WPF renders an
             element with an Effect, children included, as a bitmap, which blurs
             the text and controls inside. -->
        <Style x:Key="OverlayPanel" TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="22,18,22,16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{DynamicResource PanelBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Height="42">
                <!-- The icon alone at the left; the name stays in the window title (taskbar, Alt+Tab). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Source is set in code: the .ico frame that is 1:1 at the window's DPI, so it stays sharp. -->
                    <Image x:Name="TitleIcon" Width="16" Height="16"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMinus}"
                            Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                    <Button Click="MaxRestore_Click" AutomationProperties.Name="Maximize">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                <Setter Property="Tag" Value="{StaticResource IconSquare}"/>
                                <Setter Property="ToolTip" Value="Maximize"/>
                                <Style.Triggers>
                                    <DataTrigger Value="Maximized"
                                                 Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Setter Property="Tag" Value="{StaticResource IconRestoreWindow}"/>
                                        <Setter Property="ToolTip" Value="Restore"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Tag="{StaticResource IconClose}"
                            Click="CloseWindow_Click" ToolTip="Close" AutomationProperties.Name="Close"/>
                </StackPanel>

                <!-- Settings panel, anchored to the gear in the bottom-left corner:
                     it opens upward, its left edge on the gear's. The border has an
                     8px shadow margin, hence the offsets. -->
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsToggle}"
                       Placement="Top" HorizontalOffset="-8" VerticalOffset="6"
                       StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                       Opened="SettingsPopup_Opened" Closed="SettingsPopup_Closed">
                    <!-- The 8px shadow margin belongs to the popup's own window, so a click
                         there reaches neither the panel nor the main window. This transparent
                         grid catches it and counts it as "outside". -->
                    <Grid Background="Transparent" MouseDown="SettingsPopupMargin_MouseDown" UseLayoutRounding="True">
                    <!-- Shadow on its own layer, not on the panel: an Effect would blur the panel's text. -->
                    <Border Background="{DynamicResource PanelBrush}" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                        </Border.Effect>
                    </Border>
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            Margin="8" Padding="8" Width="260">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" Style="{StaticResource SectionLabel}" Margin="7,4,7,10"/>
                            <CheckBox Content="Run at startup" FontSize="12.5"
                                      IsChecked="{Binding StartWithWindows}" Margin="7,0,7,10"/>
                            <CheckBox IsChecked="{Binding ShowTrayIcon}" Margin="7,0,7,10">
                                <StackPanel>
                                    <TextBlock Text="Show the tray icon" FontSize="12.5"/>
                                    <TextBlock Text="hidden, start Restage again to open it" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding MonochromeTrayIcon}" Margin="7,0,7,10"
                                      IsEnabled="{Binding ShowTrayIcon}">
                                <StackPanel>
                                    <TextBlock Text="Monochrome tray icon" FontSize="12.5"/>
                                    <TextBlock Text="matches the Windows theme" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <Button Style="{StaticResource MenuRowButton}" Tag="{StaticResource IconKeyboard}"
                                    Content="{Binding AppHotkeyLabel}" Command="{Binding EditAppHotkeyCommand}"
                                    Click="SettingsRow_CloseOnClick" Margin="0,0,0,4"/>

                            <!-- What a voice tool (Hex, Handy) needs to send commands; stays the same across restarts. -->
                            <StackPanel Visibility="{Binding HasApi, Converter={StaticResource BoolToVis}}">
                                <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,6"/>
                                <TextBlock Text="VOICE CONTROL" Style="{StaticResource SectionLabel}"
                                           FontSize="10.5" Margin="7,4,7,4"/>
                                <TextBlock Text="{Binding ApiCommandUrl}" FontSize="11" Margin="7,0,7,6"
                                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="Send what was said here, as JSON {&quot;text&quot;: &quot;…&quot;}, with the token as a bearer token. It stays the same when Restage restarts."/>
                                <Button Style="{StaticResource MenuRowButton}" Tag="{StaticResource IconCopy}"
                                        Content="Copy command URL" Command="{Binding CopyApiUrlCommand}"/>
                                <Button Style="{StaticResource MenuRowButton}" Tag="{StaticResource IconCopy}"
                                        Content="{Binding ApiTokenHint}" Command="{Binding CopyApiTokenCommand}"
                                        ToolTip="Copy the token"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,6"/>
                            <TextBlock Text="WORKSPACE ON ANOTHER DESKTOP" Style="{StaticResource SectionLabel}"
                                       FontSize="10.5" Margin="7,4,7,8"/>
                            <RadioButton Style="{StaticResource DotRadio}" GroupName="DesktopSwitch" Margin="7,0,7,7"
                                         IsChecked="{Binding DesktopSwitchText, Converter={StaticResource EqualsParam}, ConverterParameter=Ask}">
                                <StackPanel>
                                    <TextBlock Text="Ask me to switch" FontSize="12.5"/>
                                    <TextBlock Text="a prompt names the desktop and waits" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource DotRadio}" GroupName="DesktopSwitch" Margin="7,0,7,6"
                                         IsChecked="{Binding DesktopSwitchText, Converter={StaticResource EqualsParam}, ConverterParameter=Never}">
                                <StackPanel>
                                    <TextBlock Text="Never switch" FontSize="12.5"/>
                                    <TextBlock Text="restore on whatever desktop is current" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,6"/>
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Follow the Windows theme" FontSize="12.5"
                                      IsChecked="{Binding FollowSystemTheme}" Margin="7,4,7,10"
                                      ToolTip="Light or dark, as set in Windows › Personalisation › Colours"/>
                            <!-- Manual light/dark switch; hidden while following Windows. -->
                            <Button Command="{Binding ToggleThemeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
                                        <Setter Property="Tag" Value="{StaticResource IconSun}"/>
                                        <Setter Property="Content" Value="{Binding ThemeTooltip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                                <Setter Property="Tag" Value="{StaticResource IconMoon}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FollowSystemTheme}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Popup>
            </Grid>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="260"/>
                <RowDefinition x:Name="BottomRow" Height="160" MinHeight="90"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="560"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Gallery -->
                <DockPanel Grid.Column="0" Margin="26,18,10,10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,16,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Workspaces" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="{Binding WorkspaceCountText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource BusyAccentButton}" Padding="16,9" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Command="{Binding NewWorkspaceCommand}"
                                ToolTip="Save everything open right now as a new workspace">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0">
                                        <Path Width="24" Height="24" Data="{StaticResource IconPlus}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2.25" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="New workspace" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
                                    <Path Style="{StaticResource SpinnerPath}" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Capturing…" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="0,0,0,60">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWorkspaces}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Viewbox Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Width="24" Height="24" Data="{StaticResource IconLayoutGrid}"
                                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.75"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <TextBlock Text="Arrange your applications, then save them" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                       Text="Click on New workspace to save the open applications, down to the virtual desktop and its wallpaper. Start brings it all back with one click."/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Scrollable_PreviewMouseWheel"
                                      Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Workspaces}" ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- Details of the selected workspace -->
                <Border Grid.Column="1" Width="392" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1,0,0,0"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel x:Name="DetailsPane" Margin="20,18,20,12" DataContext="{Binding Selected}"
                               Focusable="True" FocusVisualStyle="{x:Null}">
                        <StackPanel DockPanel.Dock="Top">
                            <!-- Click the name to rename in place: Enter or clicking elsewhere saves, Esc cancels. -->
                            <Grid>
                                <Border x:Name="NameDisplay" Margin="-6,0,0,0" Padding="5,0" HorizontalAlignment="Left"
                                        Background="Transparent" Cursor="IBeam" ToolTip="Click to rename"
                                        MouseLeftButtonUp="NameDisplay_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <TextBox x:Name="NameEditor" Visibility="Collapsed" Margin="-6,0,0,0" Padding="4,0"
                                         FontSize="20" FontWeight="SemiBold" MaxLength="48"
                                         AutomationProperties.Name="Workspace name"
                                         KeyDown="NameEditor_KeyDown" LostKeyboardFocus="NameEditor_LostKeyboardFocus"/>
                            </Grid>
                            <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                            <DockPanel Margin="0,0,0,6" Background="Transparent">
                                <DockPanel.ToolTip>
                                    <views:InfoTip Title="Virtual desktop"
                                                   Text="The Windows desktop this workspace opens on. If another desktop is showing, Start asks you to switch first, unless Settings says never."/>
                                </DockPanel.ToolTip>
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Path Width="24" Height="24" Data="{StaticResource IconMonitor}"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="{Binding DesktopName}" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6" Background="Transparent">
                                <DockPanel.ToolTip>
                                    <views:InfoTip Title="Wallpaper"
                                                   Text="The desktop background saved with this workspace, put back on start unless switched off in the edit panel (pencil)."/>
                                </DockPanel.ToolTip>
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Path Width="24" Height="24" Data="{StaticResource IconImage}"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="{Binding WallpaperName}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ApplyWallpaper}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Background="Transparent">
                                <DockPanel.ToolTip>
                                    <views:InfoTip Title="Monitor layouts"
                                                   Text="The monitor arrangements this workspace has window positions for; (current) is the one attached now. Update adds the current one when it is missing."/>
                                </DockPanel.ToolTip>
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Path Width="24" Height="24" Data="{StaticResource IconLayoutGrid}"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="{Binding ProfilesText}" FontSize="12" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock Text="No layout for the monitors attached now; Update to add one."
                                       Style="{StaticResource SubtleText}" FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding LacksCurrentProfile, Converter={StaticResource BoolToVis}}"/>

                            <!-- The workspace's global hotkey, shown like the rows above; set in the edit panel (pencil). -->
                            <DockPanel Margin="0,6,0,0" DataContext="{Binding Hotkey}" Background="Transparent">
                                <DockPanel.ToolTip>
                                    <views:InfoTip Title="Keyboard shortcut"
                                                   Text="Starts this workspace from anywhere in Windows, or brings its windows to the front when it is open. Change it with the pencil."/>
                                </DockPanel.ToolTip>
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Path Width="24" Height="24" Data="{StaticResource IconKeyboard}"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.25"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="{Binding Text}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasHotkey}" Value="False">
                                                    <Setter Property="Text" Value="No keyboard shortcut"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock DataContext="{Binding Hotkey}" Text="{Binding Problem}"
                                       Style="{StaticResource SubtleText}" FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,14">
                            <Button Style="{StaticResource AccentButton}" Padding="16,9" Content="Start"
                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconRefreshCw}"
                                    ToolTip="Update from the current desktop" Margin="0,0,8,0"
                                    Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconPencil}"
                                    ToolTip="Edit name and keyboard shortcut" Margin="0,0,8,0"
                                    AutomationProperties.Name="Edit"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFolderOpen}"
                                    ToolTip="Open the workspace's folder" Margin="0,0,8,0"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconTrash}"
                                    ToolTip="Delete"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>

                        <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ITEMS" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding Items.Count}" Style="{StaticResource NumericText}" FontSize="11"
                                           Margin="7,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Scrollable_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRowTemplate}" Margin="0,0,6,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ Activity log ============ -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                    Padding="26,10,26,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,4">
                        <!-- The settings gear has its own slot in the bottom-left corner, a clear gap
                             before the log label. -9: the 14px glyph sits 7px inside its 28px
                             button, so the gear lines up with the Workspaces title. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-9,-6,0,-6">
                            <!-- ClickMode Press: the popup opens on mouse-down, before the button
                                 would take mouse capture on the way to a release click. With the
                                 capture free, the popup takes it and closes on any click outside. -->
                            <ToggleButton x:Name="SettingsToggle" Style="{StaticResource IconToggle}" Width="28" Height="28" FontSize="14"
                                          Tag="{StaticResource IconSettings}" VerticalAlignment="Center" Margin="0,0,8,0"
                                          ClickMode="Press"
                                          AutomationProperties.Name="Settings" ToolTip="Settings"/>
                            <TextBlock Text="ACTIVITY LOG" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-6,0,-6">
                            <Button Style="{StaticResource SubtleIconButton}" Tag="{StaticResource IconEraser}"
                                    Command="{Binding ClearLogCommand}" ToolTip="Clear activity log"
                                    AutomationProperties.Name="Clear Log"/>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource ExpandToggle}"
                                          Checked="LogToggle_Toggled" Unchecked="LogToggle_Toggled"
                                          ToolTip="Show or hide the activity log"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="LogArea" Background="{DynamicResource LogBgBrush}" Padding="8,4">
                        <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                 ItemContainerStyle="{StaticResource PlainListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False"
                                 PreviewMouseWheel="Scrollable_PreviewMouseWheel"/>
                    </Border>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="7" Margin="0,-4,0,0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top"
                          Background="Transparent" Cursor="SizeNS" Focusable="False"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent"
                          DragCompleted="LogSplitter_DragCompleted"
                          ToolTip="Drag to resize the activity log"/>

            <!-- ============ Restore overlay ============ -->
            <!-- A click on the dimmed backdrop closes the panel once the start is done. -->
            <Border Grid.RowSpan="2" Background="{DynamicResource OverlayDimBrush}" Panel.ZIndex="10"
                    Visibility="{Binding ShowRestorePanel, Converter={StaticResource BoolToVis}}"
                    MouseDown="RestoreBackdrop_MouseDown">
                <ContentControl Style="{StaticResource OverlayPanel}" Width="480" MaxHeight="520">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource SpinnerPath}" Stroke="{DynamicResource TextBrush}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVis}}"/>
                                <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Path Width="24" Height="24" Data="{StaticResource IconCheck}"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="{Binding RestoreTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" Text="{Binding RestoreCounter, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RestoreNote}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"/>
                        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource ThinProgress}"
                                     Maximum="1" Value="{Binding RestoreFraction, Mode=OneWay}" Margin="0,0,0,8"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Style="{StaticResource QuietButton}" Content="Cancel"
                                    Command="{Binding CancelRestoreCommand}"
                                    Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Close" Command="{Binding CloseRestoreCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RestoreProgress}" ItemTemplate="{StaticResource RestoreRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </ContentControl>
            </Border>

            <!-- ============ Desktop switch prompt ============ -->
            <Border Grid.RowSpan="2" Background="{DynamicResource OverlayDimBrush}" Panel.ZIndex="11"
                    Visibility="{Binding ShowDesktopPrompt, Converter={StaticResource BoolToVis}}">
                <ContentControl Style="{StaticResource OverlayPanel}" Width="440" Padding="24,20,24,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path Width="24" Height="24" Data="{StaticResource IconMonitor}"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.25"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="Switch to desktop "/><Run Text="{Binding DesktopPromptName, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="This workspace lives on another virtual desktop. Press Win+Ctrl+← or → to go there, or pick it in Task View. The workspace starts automatically once you are on that desktop."/>
                        <Grid Margin="0,20,0,0">
                            <Button Style="{StaticResource QuietButton}" Content="Cancel" HorizontalAlignment="Left"
                                    Command="{Binding CancelDesktopCommand}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource QuietButton}" Content="Start here instead"
                                        Command="{Binding RestoreHereCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource AccentButton}" Padding="16,9" FontSize="12.5"
                                        Content="Open Task View" Command="{Binding OpenTaskViewCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Border>

            <!-- ============ Capture overlay ============ -->
            <Border Grid.RowSpan="2" Background="{DynamicResource OverlayDimBrush}" Panel.ZIndex="12"
                    Visibility="{Binding ShowCapture, Converter={StaticResource BoolToVis}}">
                <ContentControl Style="{StaticResource OverlayPanel}" Width="580" MaxHeight="640">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding CaptureTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding CaptureSummary}" Style="{StaticResource SubtleText}"
                                   TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <TextBlock DockPanel.Dock="Top" Text="NAME" Style="{StaticResource SectionLabel}"/>
                        <TextBox DockPanel.Dock="Top" Margin="0,6,0,14" MaxLength="48"
                                 Text="{Binding CaptureName, UpdateSourceTrigger=PropertyChanged}"
                                 IsVisibleChanged="OverlayInput_IsVisibleChanged" KeyDown="CaptureName_KeyDown"/>
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="WINDOWS FOUND" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding CaptureCount}" Style="{StaticResource NumericText}" FontSize="11"
                                           Margin="7,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right" IsThreeState="False" FontSize="12"
                                      IsChecked="{Binding CaptureAllSelected}" Content="Select all"
                                      Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource QuietButton}" Content="Cancel"
                                    Command="{Binding CaptureCancelCommand}" Margin="0,0,8,0" IsCancel="True"/>
                            <Button Style="{StaticResource AccentButton}" Padding="16,9" FontSize="12.5"
                                    Content="Save workspace" Command="{Binding CaptureSaveCommand}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Scrollable_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding CaptureItems}" ItemTemplate="{StaticResource CaptureRowTemplate}" Margin="0,0,6,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </ContentControl>
            </Border>

            <!-- ============ Edit workspace: name and keyboard shortcut ============ -->
            <!-- A click on the dimmed backdrop is a cancel; nothing is saved before Save. -->
            <Border Grid.RowSpan="2" Background="{DynamicResource OverlayDimBrush}" Panel.ZIndex="13"
                    Visibility="{Binding ShowEdit, Converter={StaticResource BoolToVis}}"
                    MouseDown="EditBackdrop_MouseDown">
                <ContentControl x:Name="EditPanel" Style="{StaticResource OverlayPanel}" Width="420" Padding="24,20,24,18"
                        Focusable="True" FocusVisualStyle="{x:Null}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <!-- The open-Restage shortcut has no name to edit. -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditingApp}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="NAME" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                            <TextBox MaxLength="48" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Workspace name"
                                     IsVisibleChanged="OverlayInput_IsVisibleChanged" KeyDown="EditName_KeyDown"/>
                            <!-- Only the switch itself takes the click, not the text next to it. -->
                            <DockPanel Margin="0,14,0,0"
                                       Visibility="{Binding EditHasWallpaper, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding EditApplyWallpaper}"
                                          AutomationProperties.Name="Apply the saved wallpaper"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Apply the saved wallpaper" FontSize="12.5"/>
                                    <TextBlock Text="when the workspace starts" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <TextBlock Text="KEYBOARD SHORTCUT" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                        <!-- The box never takes text: it records the keys pressed while it has focus. -->
                        <DockPanel DataContext="{Binding EditHotkey}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Tag="{StaticResource IconClose}"
                                    Margin="6,0,0,0" ToolTip="Remove the shortcut" AutomationProperties.Name="Remove shortcut"
                                    Command="{Binding DataContext.ClearHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}"/>
                            <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                                     Text="{Binding Display, Mode=OneWay}" Cursor="Hand"
                                     AutomationProperties.Name="Keyboard shortcut"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewKeyUp="HotkeyBox_PreviewKeyUp"
                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
                        </DockPanel>
                        <TextBlock DataContext="{Binding EditHotkey}" Text="{Binding Problem}" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{Binding EditHint}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource QuietButton}" Content="Cancel"
                                    Command="{Binding EditCancelCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource AccentButton}" Padding="16,9" FontSize="12.5"
                                    Content="Save" Command="{Binding EditSaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Border>

            <!-- ============ Confirmation prompt ============ -->
            <!-- A click on the dimmed backdrop is a cancel. -->
            <Border Grid.RowSpan="2" Background="{DynamicResource OverlayDimBrush}" Panel.ZIndex="13"
                    Visibility="{Binding ShowConfirm, Converter={StaticResource BoolToVis}}"
                    MouseDown="ConfirmBackdrop_MouseDown">
                <ContentControl Style="{StaticResource OverlayPanel}" Width="400" Padding="24,20,24,18">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConfirmMessage}" Style="{StaticResource SubtleText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBox Margin="0,14,0,0" MaxLength="48"
                                 Text="{Binding ConfirmInput, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ConfirmIsInput, Converter={StaticResource BoolToVis}}"
                                 IsVisibleChanged="OverlayInput_IsVisibleChanged" KeyDown="ConfirmInput_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource QuietButton}" Content="Cancel"
                                    Command="{Binding ConfirmCancelCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource AccentButton}" Padding="16,9" FontSize="12.5"
                                    Content="{Binding ConfirmAcceptLabel}" Command="{Binding ConfirmAcceptCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
