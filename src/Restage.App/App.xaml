<Application x:Class="Restage.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Restage.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <views:EqualsConverter x:Key="EqualsParam"/>

            <!-- Toggle switch: a CheckBox drawn as a pill with a knob, label on
                 the left and the switch at the row's right edge, as Windows
                 draws its own. State changes are instant; nothing animates. -->
            <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <DockPanel Background="Transparent" LastChildFill="True">
                                <Border x:Name="Track" DockPanel.Dock="Right" Width="36" Height="18" CornerRadius="9"
                                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1.5"
                                        Background="Transparent" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Ellipse x:Name="Knob" Width="10" Height="10" Fill="{DynamicResource MutedBrush}"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillBrush}"/>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== Type =====================
                 Inter ships in Assets\Fonts (SIL OFL 1.1). Static weights are
                 referenced by one family name; WPF picks the face off
                 FontWeight. The window sets UiFont once and it inherits. -->
            <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            </Style>

            <!-- One scale, five steps. Anything not on it is a mistake.
                 Each is BasedOn the implicit TextBlock style — an explicit Style
                 replaces the implicit one outright, and a heading that forgets
                 to inherit Foreground renders black on a black background. -->
            <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="SubtleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            </Style>

            <!-- Medium, not Bold: caps already carry the emphasis, and bold caps
                 at 11px turn into a grey smear. -->
            <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            </Style>

            <!-- Timestamps and counts stop jittering column to column. -->
            <Style x:Key="NumericText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>

